# Скопируйте в .env. Файл .env игнорируется Git.
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Для локального DEBUG=1 можно оставить пустым.
# Для production сгенерируйте значение: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# SQLite используется, пока POSTGRES_DB отсутствует или пуст.
POSTGRES_DB=
POSTGRES_USER=backend_lab
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Docker Compose требует непустой POSTGRES_PASSWORD (задайте свой).
# HTTPS production: DEBUG=0, ALLOWED_HOSTS=ваш-домен,
# CSRF_TRUSTED_ORIGINS=https://ваш-домен
# TRUST_X_FORWARDED_PROTO=1 только за доверенным reverse proxy.
